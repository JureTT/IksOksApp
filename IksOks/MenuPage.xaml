<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IksOks.MenuPage"
             BackgroundColor="#0a0a1a">

    <VerticalStackLayout Padding="24" Spacing="0"
                         VerticalOptions="Center"
                         HorizontalOptions="Center">

        <!-- Naslov -->
        <Label Text="IKS OKS"
               FontSize="42"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#00d4ff"
               CharacterSpacing="8"
               Margin="0,0,0,4"/>

        <Label Text="GAMING EDITION"
               FontSize="11"
               HorizontalOptions="Center"
               TextColor="#444466"
               CharacterSpacing="3"
               Margin="0,0,0,48"/>

        <!-- Odabir protivnika -->
        <Label Text="ODABERI PROTIVNIKA"
               FontSize="11"
               HorizontalOptions="Center"
               TextColor="#444466"
               CharacterSpacing="2"
               Margin="0,0,0,16"/>

        <Button Text="👤  IGRAČ VS IGRAČ"
                FontSize="15"
                FontAttributes="Bold"
                CharacterSpacing="1"
                Clicked="OnIgracVsIgracClicked"
                BackgroundColor="#0d0d2b"
                BorderColor="#00d4ff55"
                BorderWidth="1"
                TextColor="#00d4ff"
                CornerRadius="12"
                Padding="0,18"
                Margin="0,0,0,10"
                WidthRequest="300"/>

        <Button Text="🤖  SLABI PC"
                FontSize="15"
                FontAttributes="Bold"
                CharacterSpacing="1"
                Clicked="OnSlabiPCClicked"
                BackgroundColor="#0d0d2b"
                BorderColor="#bf00ff55"
                BorderWidth="1"
                TextColor="#bf00ff"
                CornerRadius="12"
                Padding="0,18"
                Margin="0,0,0,10"
                WidthRequest="300"/>

        <Button Text="🤖  NORMALNI PC"
                FontSize="15"
                FontAttributes="Bold"
                CharacterSpacing="1"
                Clicked="OnNormalniPCClicked"
                BackgroundColor="#0d0d2b"
                BorderColor="#bf00ff55"
                BorderWidth="1"
                TextColor="#bf00ff"
                CornerRadius="12"
                Padding="0,18"
                Margin="0,0,0,10"
                WidthRequest="300"/>

        <Button Text="🤖  JAKI PC"
                FontSize="15"
                FontAttributes="Bold"
                CharacterSpacing="1"
                Clicked="OnJakiPCClicked"
                BackgroundColor="#0d0d2b"
                BorderColor="#bf00ff55"
                BorderWidth="1"
                TextColor="#bf00ff"
                CornerRadius="12"
                Padding="0,18"
                Margin="0,0,0,40"
                WidthRequest="300"/>

        <!-- Izlaz -->
        <Button Text="IZLAZ"
                FontSize="13"
                FontAttributes="Bold"
                CharacterSpacing="2"
                Clicked="OnIzlazClicked"
                BackgroundColor="#0d0d2b"
                BorderColor="#1e1e4a"
                BorderWidth="1"
                TextColor="#444466"
                CornerRadius="12"
                Padding="0,14"
                WidthRequest="300"/>

    </VerticalStackLayout>
</ContentPage>